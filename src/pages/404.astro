---
import Base from '../layouts/Base.astro';
import { url } from '../consts';
---

<Base title="Not found">
  <section class="wrap">
    <p class="mono">404 · Proceed limit reached</p>
    <h1>This page doesn't exist.<br /><span>Maybe that's a sign.</span></h1>
    <a class="btn btn--primary" href={url()}>Back to the Journal</a>
  </section>
</Base>

<style>
  section { padding: 8rem 0 4rem; }
  h1 { font: 800 clamp(2.4rem, 6vw, 4.5rem)/1 var(--font-display); letter-spacing: -0.03em; margin: 1rem 0 2rem; }
  h1 span { color: var(--muted); font-weight: 400; }
</style>
