---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { url } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`Posts tagged “${tag}”`} description={`Curbox Journal posts about ${tag}.`}>
  <section class="wrap">
    <a class="mono back" href={url()}>← All posts</a>
    <h1><span class="mono">Tagged</span>{tag}</h1>
    <p class="mono">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
    {posts.map((post, i) => <PostCard post={post} index={i + 1} />)}
  </section>
</Base>

<style>
  section { padding-top: 4rem; }
  .back { text-decoration: none; }
  h1 { display: grid; gap: 0.75rem; margin: 2rem 0 0.5rem; font: 800 clamp(2.5rem, 7vw, 5rem)/1 var(--font-display); letter-spacing: -0.03em; }
</style>
